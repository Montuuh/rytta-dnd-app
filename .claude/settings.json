{
  "permissions": {
    "allow": ["Bash(git push --force-with-lease:*)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-sync.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}

# Browser-visible values only. Never put a service_role or sb_secret_ key here.
# Copy to .env.local. See docs/setup-google-supabase.md for Google and Supabase setup.
# Use supabase for the shared project PRE schema in local development.
# localhost/dev always uses pre; deployed production always uses public.
# Schema is selected by runtime code; do not add an editable VITE_ schema override.
VITE_DATA_MODE=demo
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# / for local development or a custom domain; /rytta-dnd-app/ for project Pages.
VITE_BASE_PATH=/

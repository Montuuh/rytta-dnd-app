# Browser-visible values only. Never put a service_role or sb_secret_ key here.
# Copy to .env.local. See docs/setup-google-supabase.md for Google and Supabase setup.
# Use supabase for the shared project PRE schema in local development.
# localhost/dev always uses pre; deployed production always uses public.
# Schema is selected by runtime code; do not add an editable VITE_ schema override.
VITE_DATA_MODE=demo
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# / for local development or a custom domain; /rytta-dnd-app/ for project Pages.
VITE_BASE_PATH=/
# Optional public origin (no path), e.g. https://example.github.io. Makes the share image and
# og:url absolute in the built index.html; leave empty for relative URLs.
VITE_SITE_URL=
# Public owner contact address shown on the privacy and terms pages and offered after an account
# is deleted. REQUIRED before the public launch: empty shows "contact address pending" and a
# production build prints a warning.
VITE_CONTACT_EMAIL=
# Full name of the natural person responsible for the service, named in the privacy policy.
# REQUIRED before the public launch: empty shows "the controller will be identified before launch"
# and a production build prints a warning. Never commit a real name; set it in .env.local or as a
# repository variable.
VITE_OWNER_NAME=
# RYT-157: public Cloudflare Turnstile site key for the email sign-in bot check. Needed once the
# Supabase project requires a CAPTCHA; the matching secret key is set only in Supabase Auth.
VITE_TURNSTILE_SITE_KEY=

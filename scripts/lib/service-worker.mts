/**
 * RYT-128: the offline shell. The build writes `sw.js` next to index.html. It keeps only the app's
 * own static files so a reload without signal still opens the app; it never stores a backend,
 * Auth or Storage response (those are other origins) or anything private.
 *
 * - Navigations to the app's base path: network first; offline, the cached index.html.
 * - Hashed build files under `<base>assets/`, and the brand, icon and empty-state images: cache
 *   first. Each build has its own cache, so a changed image arrives with the next build.
 * - The shell files listed at build time: precached on install; the build files the page loaded
 *   before the worker took control are added when the page reports them.
 * - Everything else (other origins, version.json, legal pages, art): left to the network.
 *
 * Each build has its own cache; activating a new worker deletes the caches of older builds. A new
 * worker waits until the page asks it to take over (the version notice's Reload) or every tab of
 * the old build is closed, so an open form never loses its input to a forced reload.
 */

/** Same-origin URLs the shell needs: index.html, its scripts, styles and preloads, the manifest. */
export function shellUrls(html: string, base: string): string[] {
  const found = new Set<string>([base, `${base}manifest.webmanifest`])
  for (const match of html.matchAll(/\b(?:src|href)="([^"]+)"/g)) {
    const url = match[1] ?? ''
    if (url.startsWith(`${base}assets/`)) found.add(url)
  }
  return [...found]
}

export type Route = 'navigation' | 'asset' | 'shell' | 'network'

/**
 * How the worker answers one request. Plain data in, a decision out, so it can be tested here
 * and inlined into the worker unchanged.
 */
export function route(
  request: { method: string; mode: string; url: string },
  scope: { origin: string; base: string; shell: string[] },
): Route {
  if (request.method !== 'GET') return 'network'
  const url = new URL(request.url)
  if (url.origin !== scope.origin) return 'network'
  if (request.mode === 'navigate')
    return url.pathname === scope.base || url.pathname === `${scope.base}index.html`
      ? 'navigation'
      : 'network'
  if (url.search) return 'network'
  // Hashed build files, and the few images every screen shows (brand, icons, empty states).
  if (
    ['assets/', 'icons/', 'art/brand/', 'art/empty/'].some((dir) =>
      url.pathname.startsWith(scope.base + dir),
    )
  )
    return 'asset'
  if (scope.shell.includes(url.pathname)) return 'shell'
  return 'network'
}

/** The worker script for one build. */
export function serviceWorkerSource(options: { buildId: string; base: string; shell: string[] }) {
  const cacheName = `rytta-shell-${options.buildId}`
  return `/* Rytta offline shell (RYT-128). Generated by the build; do not edit. */
const CACHE = ${JSON.stringify(cacheName)}
const BASE = ${JSON.stringify(options.base)}
const SHELL = ${JSON.stringify(options.shell)}
const route = ${route.toString()}

self.addEventListener('install', (event) => {
  event.waitUntil(caches.open(CACHE).then((cache) => cache.addAll(SHELL)))
})

self.addEventListener('activate', (event) => {
  event.waitUntil(
    caches
      .keys()
      .then((keys) =>
        Promise.all(
          keys
            .filter((key) => key.startsWith('rytta-shell-') && key !== CACHE)
            .map((key) => caches.delete(key)),
        ),
      )
      .then(() => self.clients.claim()),
  )
})

self.addEventListener('message', (event) => {
  if (event.data === 'rytta-activate') self.skipWaiting()
  // Build files the page loaded before this worker controlled it (the first visit).
  if (event.data && event.data.type === 'rytta-loaded' && Array.isArray(event.data.urls)) {
    const urls = event.data.urls.filter(
      (url) =>
        typeof url === 'string' &&
        route(
          { method: 'GET', mode: 'cors', url },
          { origin: self.location.origin, base: BASE, shell: SHELL },
        ) === 'asset',
    )
    event.waitUntil(
      caches.open(CACHE).then((cache) =>
        Promise.all(
          urls.map((url) =>
            cache.match(url, { ignoreVary: true }).then((hit) => hit || cache.add(url).catch(() => undefined)),
          ),
        ),
      ),
    )
  }
})

self.addEventListener('fetch', (event) => {
  const request = event.request
  const kind = route(
    { method: request.method, mode: request.mode, url: request.url },
    { origin: self.location.origin, base: BASE, shell: SHELL },
  )
  if (kind === 'network') return
  if (kind === 'navigation') {
    event.respondWith(
      fetch(request).then(
        (response) => {
          if (response.ok) {
            const copy = response.clone()
            void caches.open(CACHE).then((cache) => cache.put(BASE, copy))
          }
          return response
        },
        () => caches.match(BASE, { cacheName: CACHE, ignoreVary: true }).then((cached) => cached || Response.error()),
      ),
    )
    return
  }
  event.respondWith(
    caches.match(request, { cacheName: CACHE, ignoreVary: true }).then(
      (cached) =>
        cached ||
        fetch(request).then((response) => {
          if (response.ok && kind === 'asset') {
            const copy = response.clone()
            void caches.open(CACHE).then((cache) => cache.put(request, copy))
          }
          return response
        }),
    ),
  )
})
`
}

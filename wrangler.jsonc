{
  "name": "rytta-dnd",
  "compatibility_date": "2026-11-17",
  // Reachable at the Worker's workers.dev address after the first successful deploy.
  "workers_dev": true,
  // Preview URLs stay off until a preview configuration that uses the staging backend exists.
  "preview_urls": false,
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
  },
}
